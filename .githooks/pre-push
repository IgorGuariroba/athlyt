#!/usr/bin/env bash
set -euo pipefail

BRANCH_PROTEGIDA="refs/heads/main"

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$BRANCH_PROTEGIDA" ] && {
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
      echo "pre-push: recusado — deleção da main." >&2
      exit 1
    fi

    echo "pre-push: push direto para main detectado."
    echo "pre-push: o fluxo esperado é pull request com CI verde."
    echo "pre-push: rodando os portões rápidos localmente..."
    npm run lint
    npm run typecheck
  }

  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    echo "pre-push: exclusão de branch não protegida — nenhum teste executado."
    continue
  fi

  base_sha="$remote_sha"
  if [ "$base_sha" = "0000000000000000000000000000000000000000" ]; then
    if ! base_sha=$(git merge-base "$local_sha" refs/heads/main 2>/dev/null); then
      echo "pre-push: modo=completo; base/head/arquivos selecionados=indisponíveis" >&2
      echo "pre-push: testes selecionados=todos os unitários" >&2
      echo "pre-push: motivo=base Git indisponível" >&2
      npm run test:unit
      base_sha=$(git rev-parse "$local_sha^" 2>/dev/null || printf '%s' "$local_sha")
    else
      # O seletor recusa a árvore suja: testar o commit enviado contra
      # alterações locais faria o resultado deixar de ser evidência publicada.
      npx tsx scripts/testes-impactados.ts --base "$base_sha" --head "$local_sha"
    fi
  else
    npx tsx scripts/testes-impactados.ts --base "$base_sha" --head "$local_sha"
  fi

  # Configuração, lockfile e schema exigem integração em qualquer ref; não
  # apenas quando o destino é main.
  integracao_necessaria=0
  while IFS= read -r -d '' arquivo; do
    if [[ "$arquivo" =~ ^(package(-lock)?\.json|vitest\.config\.|vitest\.setup\.|tsconfig(\..+)?\.json|drizzle/|drizzle\.config\.|src/db/schema\.) ]]; then
      integracao_necessaria=1
      break
    fi
  done < <(git diff --name-only -z "$base_sha" "$local_sha")

  if [ "$integracao_necessaria" = 1 ]; then
    npm run test:int
  fi

  # Em vez de uma allowlist de UI, só alterações inequivocamente não-produto
  # dispensam E2E. Mudanças em auth, serviços, configuração ou scripts ficam
  # no lado seguro e executam a jornada completa.
  e2e_necessario=0
  while IFS= read -r -d '' arquivo; do
    if [[ "$arquivo" != docs/* && "$arquivo" != .vscode/* && "$arquivo" != *.md ]]; then
      e2e_necessario=1
      break
    fi
  done < <(git diff --name-only -z "$base_sha" "$local_sha")

  if [ "$e2e_necessario" = 1 ]; then
    echo "pre-push: alteração de produto ou infraestrutura — executando E2E..."
    echo "pre-push: compilando o build de produção para o E2E..."
    npm run build
    mkdir -p .next/standalone/.next
    cp -r .next/static .next/standalone/.next/static
    cp -r public .next/standalone/public
    # Permite isolar o servidor sem reutilizar uma instância antiga na 3000.
    # PLAYWRIGHT_BASE_URL deve apontar para a mesma porta.
    E2E_COMANDO="node .next/standalone/server.js" PORT="${PORT:-3000}" npm run test:e2e
  else
    echo "pre-push: somente documentação/configuração visual — E2E não executado."
  fi
done

echo "pre-push: portões locais OK."
