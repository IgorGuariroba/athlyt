#!/usr/bin/env bash
set -euo pipefail

BRANCH_PROTEGIDA="main"
BRANCH_ATUAL="$(git symbolic-ref --quiet --short HEAD || true)"

if [ "$BRANCH_ATUAL" = "$BRANCH_PROTEGIDA" ]; then
  echo "pre-commit: commit direto na main recusado." >&2
  echo "pre-commit: crie uma branch de trabalho e abra um pull request." >&2
  exit 1
fi
