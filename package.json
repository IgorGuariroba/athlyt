{
  "name": "athlyt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev-local.sh up",
    "down": "bash scripts/dev-local.sh down",
    "dev:banco": "npm run db:up && next dev",
    "dev:observability": "OBSERVABILITY_ENABLED=true OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 next dev",
    "db:up": "docker compose -f docker/compose.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.yml down",
    "db:logs": "docker compose -f docker/compose.yml logs -f db",
    "observability:up": "docker compose -f observability/compose.yml up -d",
    "observability:down": "docker compose -f observability/compose.yml down",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "node .next/standalone/server.js",
    "app:up": "npm run db:up && bash scripts/app-local.sh up",
    "app:down": "bash scripts/app-local.sh down",
    "app:down:app": "bash scripts/app-local.sh down-app",
    "app:status": "bash scripts/app-local.sh status",
    "app:logs": "bash scripts/app-local.sh logs",
    "stop": "npm run app:down",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unidade",
    "test:int": "vitest run --project integracao",
    "test:watch": "vitest --project unidade",
    "test:e2e": "playwright test",
    "test:e2e:visivel": "playwright test --headed --project=mobile-chrome",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ui:verificar": "vitest run --project unidade src/arquitetura/__tests__/governanca-ui.unit.test.ts",
    "storybook": "bash scripts/storybook-local.sh",
    "storybook:build": "storybook build",
    "storybook:verificar": "tsx scripts/verificar-stories.ts",
    "storybook:a11y": "tsx scripts/verificar-a11y.ts",
    "ia:verificar": "tsx scripts/verificar-ia.ts",
    "ia:modalidades": "tsx scripts/verificar-modalidades.ts",
    "ia:verificar-visual": "tsx scripts/verificar-avaliacao-visual.ts",
    "ia:verificar-refeicao-foto": "tsx scripts/verificar-refeicao-foto.ts",
    "storage:verificar": "tsx scripts/verificar-r2.ts",
    "midia:importar": "tsx scripts/importar-midia-exercicios.ts",
    "equipamentos:imagens": "tsx scripts/importar-imagens-equipamentos-repdb.ts",
    "storage:retencao": "tsx scripts/aplicar-retencao-fotos.ts"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "browserslist": "^4.28.9",
    "nanoid": "^3.3.17",
    "sharp": "^0.35.3",
    "@hono/node-server": "^2.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.17",
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@serwist/next": "^9.5.12",
    "@tanstack/react-query": "^5.101.4",
    "ai": "^7.0.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.26.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg-boss": "^12.26.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.14.1",
    "storybook": "^10.5.10",
    "storybook-addon-pseudo-states": "^10.5.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "eslint-plugin-storybook": "10.5.10"
  }
}
