{
  "name": "athlyt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:banco": "npm run db:up && next dev",
    "dev:observability": "OBSERVABILITY_ENABLED=true OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 next dev",
    "db:up": "docker compose -f docker/compose.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.yml down",
    "db:logs": "docker compose -f docker/compose.yml logs -f db",
    "observability:up": "docker compose -f observability/compose.yml up -d",
    "observability:down": "docker compose -f observability/compose.yml down",
    "build": "next build --webpack",
    "start": "next start",
    "start:banco": "npm run db:up && next start",
    "stop": "npm run db:down",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unidade",
    "test:int": "vitest run --project integracao",
    "test:watch": "vitest --project unidade",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ia:verificar": "tsx scripts/verificar-ia.ts",
    "ia:verificar-visual": "tsx scripts/verificar-avaliacao-visual.ts",
    "storage:verificar": "tsx scripts/verificar-r2.ts",
    "storage:retencao": "tsx scripts/aplicar-retencao-fotos.ts"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.34",
    "js-yaml": "^4.3.1",
    "fast-uri": "^3.1.5"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.17",
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@serwist/next": "^9.5.12",
    "@tanstack/react-query": "^5.101.4",
    "ai": "^7.0.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.26.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pg-boss": "^12.26.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "^9.5.12",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
