# Variáveis do compose de produção (docker/compose.prod.yml).
#
# Copie para `.env.prod`, preencha e mantenha FORA do git (o
# .gitignore já cobre `.env*`). No Dokploy, cole este conteúdo no
# painel de Environment do serviço Compose em vez de versionar.

# --- Banco (o compose monta a DATABASE_URL a partir destes) ---
POSTGRES_USER=athlyt
POSTGRES_PASSWORD=
POSTGRES_DB=athlyt

# --- Auth.js ---
# Gere com: npx auth secret
AUTH_SECRET=
# Domínio público real, com https.
AUTH_URL=https://seu-dominio
# Google Cloud Console > Credentials > OAuth Client ID.
# Redirect URI autorizado: https://seu-dominio/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- OpenRouter (ADR 0005) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
IA_AMBIENTE=producao

# --- Cloudflare R2 (ADR 0003) ---
# Bucket de produção, distinto do bucket de testes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Operação ---
APP_ENV=producao
LOG_LEVEL=info

# Porta publicada no host e interface de bind. O padrão 127.0.0.1
# mantém o app fora da internet: só o proxy reverso o alcança.
APP_PORT=3000
APP_BIND=127.0.0.1

# Tag da imagem construída localmente.
APP_TAG=latest

# --- Backup do Postgres (serviço `backup`) ---
# Bucket S3/R2 dos dumps. Use um bucket DIFERENTE do R2_BUCKET das
# fotos: a retenção apaga por idade e não deve alcançar dado de
# usuário. Obrigatório.
BACKUP_S3_BUCKET=

# Agenda cron (UTC dentro do container). Padrão: 03:00 diário.
BACKUP_CRON=0 3 * * *

# Dias de retenção dos dumps no bucket.
BACKUP_RETENCAO_DIAS=30

# Executa um backup logo na subida do container, útil para validar a
# configuração sem esperar a janela agendada.
BACKUP_AO_INICIAR=false

# Prefixo ("pasta") dentro do bucket.
BACKUP_S3_PREFIXO=athlyt/postgres

# Por padrão o backup reaproveita endpoint e credenciais do R2 acima.
# Preencha apenas para enviar os dumps a outra conta/provedor S3 —
# separar as credenciais limita o estrago de uma chave vazada.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Observabilidade (opcional, docs/observabilidade.md) ---
OBSERVABILITY_ENABLED=false
OTEL_SERVICE_NAME=athlyt
OTEL_EXPORTER_OTLP_ENDPOINT=
